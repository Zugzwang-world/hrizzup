{
  "_about": "The Vercel project's settings, applied and read back by apply.py (README.md). Names and values only; no secrets. Blueprint section 6. protectionExceptions: the domains Vercel's login doesn't cover (Deployment Protection Exceptions): only staging's, from PLAN.md step 1.5d, so the app can reach staging's typed API; previews and the private address of every build stay behind the login.",
  "team": "hrizzup",
  "project": "hrizzup",
  "git": {
    "repo": "Zugzwang-world/hrizzup",
    "productionBranch": "main"
  },
  "settings": {
    "framework": "nextjs",
    "rootDirectory": "product/web",
    "sourceFilesOutsideRootDirectory": true,
    "nodeVersion": "24.x",
    "autoAssignCustomDomains": false,
    "ssoProtection": {
      "deploymentType": "all_except_custom_domains"
    },
    "skewProtectionMaxAge": 43200,
    "enablePreviewFeedback": true,
    "enableProductionFeedback": false,
    "gitForkProtection": true,
    "customerSupportCodeVisibility": false,
    "directoryListing": false,
    "enableAffectedProjectsDeployments": false,
    "gitProviderOptions": {
      "createDeployments": "enabled",
      "disableRepositoryDispatchEvents": true
    },
    "resourceConfig": {
      "fluid": true,
      "functionDefaultRegions": [
        "bom1"
      ]
    }
  },
  "customEnvironments": {
    "staging": {
      "description": "Staging: every merge to main, after its migrations (.github/workflows/staging.yml moves the staging branch). Doppler stg.",
      "branchMatcher": {
        "type": "equals",
        "pattern": "staging"
      },
      "domains": [
        "staging.hrizzup.com"
      ]
    }
  },
  "domains": {
    "hrizzup.com": {},
    "www.hrizzup.com": {
      "redirect": "hrizzup.com",
      "redirectStatusCode": 308
    }
  },
  "protectionExceptions": [
    "staging.hrizzup.com"
  ]
}
