{
  "_about": "Supabase Auth settings, applied by apply.py (README.md). Names and non-secret values only: each secret is named by the environment variable that supplies it at run time, from Doppler. Staging and production share every setting except the addresses, the project and the hourly email limit. No `vercel.app` address is ever allowed, because anyone can create one: previews sign in through staging's signed relay (`/auth/relay`, product/web/lib/auth-relay.ts). The sign-in methods that are on are exactly the *_enabled switches set to true here; apply.py fails if any other is on.",
  "environments": {
    "staging": {
      "project_ref": "mlccgqxtqmllwbyjfzzm",
      "settings": {
        "site_url": "https://staging.hrizzup.com",
        "uri_allow_list": "https://staging.hrizzup.com/**,http://localhost:3000/**",
        "rate_limit_email_sent": 30
      }
    },
    "production": {
      "project_ref": null,
      "_note": "project_ref is filled in when hrizzup-production exists (runbook step 10.3). rate_limit_email_sent (emails an hour, whole project) is raised before launch to fit expected sign-ups. Native app redirects join uri_allow_list with the app builds.",
      "settings": {
        "site_url": "https://hrizzup.com",
        "uri_allow_list": "https://hrizzup.com/**,https://www.hrizzup.com/**",
        "rate_limit_email_sent": 30
      }
    }
  },
  "shared": {
    "disable_signup": false,
    "external_google_enabled": true,
    "external_google_email_optional": false,
    "external_google_skip_nonce_check": false,
    "external_email_enabled": true,
    "mailer_autoconfirm": false,
    "mailer_secure_email_change_enabled": true,
    "mailer_otp_length": 8,
    "mailer_otp_exp": 600,
    "password_min_length": 12,
    "password_hibp_enabled": true,
    "mailer_subjects_confirmation": "Your Hrizzup sign-in code",
    "mailer_subjects_magic_link": "Your Hrizzup sign-in code",
    "mailer_subjects_recovery": "Your Hrizzup sign-in code",
    "mailer_subjects_email_change": "Confirm your Hrizzup email change",
    "smtp_host": "smtp.resend.com",
    "smtp_port": "465",
    "smtp_user": "resend",
    "smtp_admin_email": "no-reply@mail.hrizzup.com",
    "smtp_sender_name": "Hrizzup",
    "smtp_max_frequency": 60,
    "rate_limit_otp": 30,
    "rate_limit_verify": 30,
    "security_captcha_enabled": true,
    "security_captcha_provider": "turnstile"
  },
  "templates": {
    "mailer_templates_confirmation_content": "templates/sign-in-code.html",
    "mailer_templates_magic_link_content": "templates/sign-in-code.html",
    "mailer_templates_recovery_content": "templates/sign-in-code.html",
    "mailer_templates_email_change_content": "templates/email-change-code.html"
  },
  "secrets": {
    "external_google_client_id": "GOOGLE_OAUTH_CLIENT_ID",
    "external_google_secret": "GOOGLE_OAUTH_CLIENT_SECRET",
    "smtp_pass": "RESEND_API_KEY",
    "security_captcha_secret": "TURNSTILE_SECRET_KEY"
  }
