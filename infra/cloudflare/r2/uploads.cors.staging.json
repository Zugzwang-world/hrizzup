{
  "rules": [
    {
      "id": "uploads-from-our-sites",
      "allowed": {
        "origins": [
          "https://staging.hrizzup.com",
          "http://localhost:3000",
          "http://localhost:3101",
          "http://localhost:3102",
          "http://localhost:3103",
          "http://localhost:3104",
          "https://hrizzup-*-hrizzup.vercel.app"
        ],
        "methods": ["PUT"],
        "headers": ["content-type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
