{
  "rules": [
    {
      "id": "uploads-from-our-sites",
      "allowed": {
        "origins": ["https://staging.hrizzup.com", "http://localhost:3000", "https://hrizzup-*-hrizzup.vercel.app"],
        "methods": ["PUT"],
        "headers": ["content-type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
