# Hrizzup: files that must never be committed.
# Secrets live only in Doppler. These rules apply in every folder of the repo.

# ---- Environment files: every kind, everywhere, no exceptions ----
.env
.env*
*.env
*.env.*
.envrc
.direnv/

# ---- Keys, certificates and signing files ----
*.pem
*.key
*.crt
*.p8
*.p12
*.pfx
*.jks
*.keystore
!debug.keystore
*.mobileprovision
*.cer
# Public certificates the code checks servers against (not secrets):
!infra/supabase/supabase-root-2021-ca.crt
service-account*.json
*-service-account.json

# ---- Hosting and tool state (may hold project IDs or pulled variables) ----
.vercel/
.doppler/
supabase/.temp/
supabase/.branches/

# ---- Dependencies ----
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
.npm/

# ---- Build output and caches ----
dist/
build/
out/
.next/
.nuxt/
.output/
.expo/
.turbo/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts

# ---- Mobile builds ----
*.apk
*.aab
*.ipa
.gradle/
**/android/app/build/
**/ios/Pods/
**/ios/build/
DerivedData/
xcuserdata/

# ---- Tests and browser automation ----
coverage/
.nyc_output/
test-results/
screenshots/
playwright-report/
blob-report/
playwright/.cache/
.playwright-mcp/

# ---- Local data (may hold user data) ----
*.sqlite
*.sqlite3
*.db
*.dump

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Claude Code: personal settings stay on each person's machine ----
.claude/settings.local.json
CLAUDE.local.md

# ---- Operating system and editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Python bytecode caches
__pycache__/
*.pyc

# ---- The app's native projects: generated by `expo prebuild`, never committed ----
product/app/android/
product/app/ios/
product/app/journeys-build/
