{
  "name": "@hrizzup/design",
  "private": true,
  "description": "Hrizzup's design values, defined once for the website and the app: colours (light and dark), typefaces, text styles, spacing, corners, icons and motion.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "write": "node scripts/write.ts --write"
  },
  "devDependencies": {
    "@hrizzup/agreement": "workspace:*",
    "@hrizzup/tsconfig": "workspace:*",
    "@types/node": "^24.10.0",
    "lucide": "^1.69.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
