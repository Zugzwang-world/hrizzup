{
  "health": {
    "~orpc": {
      "errorMap": {},
      "meta": {
        "caching": {
          "kind": "public",
          "edgeSeconds": 30,
          "staleSeconds": 300,
          "tags": [
            "health"
          ]
        }
      },
      "route": {
        "method": "GET",
        "path": "/health",
        "summary": "Whether the API and the services behind it answer",
        "tags": [
          "public"
        ]
      }
    }
  },
  "me": {
    "~orpc": {
      "errorMap": {},
      "meta": {
        "caching": {
          "kind": "personal"
        }
      },
      "route": {
        "method": "GET",
        "path": "/me",
        "summary": "Who is signed in",
        "tags": [
          "personal"
        ]
      }
    }
  },
  "admin": {
    "markets": {
      "list": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "caching": {
              "kind": "personal"
            }
          },
          "route": {
            "method": "GET",
            "path": "/admin/markets",
            "summary": "Markets, newest first (admins only)",
            "tags": [
              "admin"
            ]
          }
        }
      },
      "get": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "caching": {
              "kind": "personal"
            }
          },
          "route": {
            "method": "GET",
            "path": "/admin/markets/{id}",
            "summary": "One market, with its log (admins only)",
            "tags": [
              "admin"
            ]
          }
        }
      },
      "create": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "caching": {
              "kind": "personal"
            }
          },
          "route": {
            "method": "POST",
            "path": "/admin/markets",
            "successStatus": 201,
            "summary": "Create a market, as a draft (admins only)",
            "tags": [
              "admin"
            ]
          }
        }
      },
      "open": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "caching": {
              "kind": "personal"
            }
          },
          "route": {
            "method": "POST",
            "path": "/admin/markets/{id}/open",
            "summary": "Open a draft market (admins only)",
            "tags": [
              "admin"
            ]
          }
        }
      },
      "close": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "caching": {
              "kind": "personal"
            }
          },
          "route": {
            "method": "POST",
            "path": "/admin/markets/{id}/close",
            "summary": "Close an open market (admins only)",
            "tags": [
              "admin"
            ]
          }
        }
      },
      "settle": {
        "~orpc": {
          "errorMap": {},
          "meta": {
            "caching": {
              "kind": "personal"
            }
          },
          "route": {
            "method": "POST",
            "path": "/admin/markets/{id}/settle",
            "summary": "Settle a closed market by hand (admins only)",
            "tags": [
              "admin"
            ]
          }
        }
      }
    }
  }
}
