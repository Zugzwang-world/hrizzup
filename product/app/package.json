{
  "name": "@hrizzup/app",
  "private": true,
  "description": "The Hrizzup app (Expo, for Android and iPhone). An empty shell for now (PLAN.md step 1.5).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "bundle-size": "node scripts/bundle-size.ts measure"
  },
  "dependencies": {
    "@hrizzup/api": "workspace:*",
    "@hrizzup/core": "workspace:*",
    "@orpc/client": "1.16.1",
    "@orpc/openapi-client": "1.16.1",
    "@orpc/tanstack-query": "1.16.1",
    "@tanstack/react-query": "^5.106.1",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "~0.88.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-parameters": "^7.29.7",
    "@hrizzup/tsconfig": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "~58.0.23",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
