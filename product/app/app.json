{
  "expo": {
    "name": "Hrizzup",
    "slug": "hrizzup",
    "owner": "hrizzups-team",
    "scheme": "hrizzup",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.hrizzup.app"
    },
    "ios": {
      "bundleIdentifier": "com.hrizzup.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false,
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0895fd14-de7a-4ce2-a6a3-b6bf070db8ea"
      }
    }
  }
}
